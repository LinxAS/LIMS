{
  "_version": "1.65.0",
  "sap.app": {
    "id": "lims.manage.forecasts",
    "type": "application",
    "title": "Manage Forecasts",
    "description": "View, submit and manage material demand forecasts",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/lims/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "ForecastsList",
          "target": "ForecastsList",
          "pattern": ":?query:"
        },
        {
          "name": "ForecastsObjectPage",
          "target": "ForecastsObjectPage",
          "pattern": "Forecasts({key}):?query:"
        }
      ],
      "targets": {
        "ForecastsList": {
          "type": "Component",
          "id": "ForecastsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Forecasts",
              "navigation": {
                "Forecasts": {
                  "detail": { "route": "ForecastsObjectPage" }
                }
              }
            }
          }
        },
        "ForecastsObjectPage": {
          "type": "Component",
          "id": "ForecastsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Forecasts",
              "navigation": {
                "items": {
                  "detail": { "route": "ForecastItemsObjectPage" }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": ["F-LIMS-006"],
    "archeType": "transactional"
  }
}
