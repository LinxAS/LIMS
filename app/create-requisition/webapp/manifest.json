{
  "_version": "1.65.0",
  "sap.app": {
    "id": "lims.create.requisition",
    "type": "application",
    "title": "Create Requisition",
    "description": "Create a new laboratory material requisition",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/lims/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "RequisitionsObjectPage",
          "target": "RequisitionsObjectPage",
          "pattern": ""
        }
      ],
      "targets": {
        "RequisitionsObjectPage": {
          "type": "Component",
          "id": "RequisitionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Requisitions",
              "createMode": true
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": ["F-LIMS-002"],
    "archeType": "transactional"
  }
}
