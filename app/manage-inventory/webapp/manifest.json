{
  "_version": "1.65.0",
  "sap.app": {
    "id": "lims.manage.inventory",
    "type": "application",
    "title": "Manage Inventory",
    "description": "Track and manage laboratory material stock levels",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/lims/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "InventoryList",
          "target": "InventoryList",
          "pattern": ":?query:"
        },
        {
          "name": "InventoryObjectPage",
          "target": "InventoryObjectPage",
          "pattern": "Inventory({key}):?query:"
        }
      ],
      "targets": {
        "InventoryList": {
          "type": "Component",
          "id": "InventoryList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Inventory",
              "navigation": {
                "Inventory": {
                  "detail": { "route": "InventoryObjectPage" }
                }
              }
            }
          }
        },
        "InventoryObjectPage": {
          "type": "Component",
          "id": "InventoryObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Inventory"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": ["F-LIMS-003"],
    "archeType": "analytical"
  }
}
